{
  "name": "@sudive-ai/cordis-plugin-group",
  "description": "Group plugin for Cordis (vendored @cordisjs/plugin-group)",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "@sudive-ai/cordis": "workspace:^",
    "@sudive-ai/cordis-plugin-loader": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudive-ai/datum.git",
    "directory": "vendor/group"
  }
}
