{
  "name": "@sudive-ai/cordis",
  "description": "Meta-Framework for Modern JavaScript Applications (vendored Cordis core 4.0.0-rc.7; the Datum L0 kernel)",
  "version": "4.0.0-rc.7",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "author": "Shigma <shigma10826@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@sudive-ai/cordis-plugin-include": "workspace:^",
    "@sudive-ai/cordis-plugin-loader": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@sudive-ai/cordis-plugin-include": {
      "optional": true
    },
    "@sudive-ai/cordis-plugin-loader": {
      "optional": true
    }
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@sudive-ai/cosmokit": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudive-ai/datum.git",
    "directory": "vendor/cordis"
  }
}
