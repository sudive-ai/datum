{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "lib",
    "rootDir": "src",
    "tsBuildInfoFile": "lib/tsbuildinfo",
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictFunctionTypes": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": false
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../cosmokit"
    },
    {
      "path": "../cordis"
    }
  ]
}
