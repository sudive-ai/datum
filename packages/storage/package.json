{
  "name": "@sudive-ai/datum-storage",
  "description": "Datum storage seam — pluggable persistence engines for session logs, traces, and sessions: SQLite (default local) and PostgreSQL (optional), fail-closed reads (M-layer extension of the Datum runtime)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --experimental-strip-types --experimental-sqlite --test test/*.test.ts"
  },
  "dependencies": {
    "@sudive-ai/cordis": "workspace:^",
    "@sudive-ai/datum-session": "workspace:^",
    "@sudive-ai/datum-vocabulary": "workspace:^",
    "postgres": "^3.4.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudive-ai/datum.git",
    "directory": "packages/storage"
  }
}
