{
  "name": "@sudive-ai/datum-workbench",
  "description": "Datum M4 workbench core — local web workbench (HTTP + SSE), config resolution, user-plugin loading, and the approval chokepoint wiring (M4 of the Datum runtime)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@sudive-ai/cordis": "workspace:^",
    "@sudive-ai/datum-loop": "workspace:^",
    "@sudive-ai/datum-session": "workspace:^",
    "@sudive-ai/datum-tools": "workspace:^",
    "@sudive-ai/datum-vocabulary": "workspace:^",
    "@sudive-ai/schemastery": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudive-ai/datum.git",
    "directory": "packages/workbench"
  }
}
