{
  "name": "@sudive-ai/datum-loop",
  "description": "Datum M2 reliable execution — the agent contract, the turn/step state machine, cancellation, the pre-step/request waterfalls, and the default harness (M2 of the Datum runtime)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@sudive-ai/cordis": "workspace:^",
    "@sudive-ai/datum-session": "workspace:^",
    "@sudive-ai/datum-tools": "workspace:^",
    "@sudive-ai/datum-vocabulary": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudive-ai/datum.git",
    "directory": "packages/loop"
  }
}
