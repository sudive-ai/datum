{
  "name": "@sudive-ai/datum-vocabulary",
  "description": "Datum L1 type vocabulary — the fixed language: session event map, five word maps, agent events, branded IDs, and the five dispatch modes (L1 of the Datum runtime)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@sudive-ai/cordis": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudive-ai/datum.git",
    "directory": "packages/vocabulary"
  }
}
