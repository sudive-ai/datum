# Datum workbench environment configuration
# Copy to `.env` and fill in what you need — `.env` is gitignored, keys never
# enter config files or the log. Loaded automatically by `pnpm demo`.

# --- LLM (real model; omit to run keyless on the mock adapter) ---
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
OPENAI_API_KEY=sk-...

# --- Workbench ---
PORT=8642

# --- Storage (defaults: sqlite at datum.db) ---
# DATUM_STORAGE_ENGINE=postgres
# DATUM_DB_PATH=datum.db
DATUM_PG_URL=postgres://user:pass@host:5432/datum
